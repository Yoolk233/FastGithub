<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>FastGithub</AssemblyName>
    <RootNamespace>FastGithub</RootNamespace>
    <Version>1.2.2.0</Version>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2Criticalissuefix</InformationalVersion>
    <Product>FastGithub</Product>
    <Company>FastGithub</Company>
    <Description>GitHub 网页直连与下载加速工具（hosts 优选 + 镜像前缀）</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/FastGithub.ico</ApplicationIcon>
    <!-- 原始工程关闭了默认编译绑定，DataGrid 列使用反射 Binding -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
  </ItemGroup>

</Project>
